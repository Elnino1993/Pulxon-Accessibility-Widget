{
  "name": "@pulxon/widget",
  "version": "0.3.0",
  "description": "Open-source accessibility preferences widget by Pulxon",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": "./dist/pulxon.min.js",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/pulxon.min.js"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.iife.config.ts && tsc -p tsconfig.build.json && node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "e2e": "playwright test",
    "publint": "publint"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/opendyslexic": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@size-limit/file": "^13.1.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.24",
    "size-limit": "^13.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
